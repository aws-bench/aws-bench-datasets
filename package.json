{
  "name": "aws-bench-datasets",
  "version": "0.7.0",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath hooks || true"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/test_*.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  },
  "overrides": {
    "minimatch": "^3.1.4",
    "brace-expansion": "1.1.16",
    "handlebars": "^4.7.9"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.7.5",
    "jest": "^29.5.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.6.3"
  }
}
